# ==========================================
# BACKEND PRODUCTION ENVIRONMENT VARIABLES
# ==========================================
# DO NOT commit real passwords here. 
# Copy this to '.env' locally or paste into Render's Environment Variables dashboard.

# SUPABASE POSTGRESQL (Get from Supabase Dashboard -> Settings -> Database)
SPRING_DATASOURCE_URL=jdbc:postgresql://db.YOUR_PROJECT_REF.supabase.co:5432/postgres
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_secure_supabase_password

# GMAIL SMTP (Use an App Password, NOT your real Gmail password)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_USERNAME=admin@dermaaline.com
SPRING_MAIL_PASSWORD=your_16_digit_app_password

# SECURITY (Generate a random 64-character hex string)
JWT_SECRET=your_secure_random_cryptographic_key_here
FRONTEND_URL=https://dermaaline.vercel.app