# ==========================================
# BACKEND PRODUCTION ENVIRONMENT VARIABLES
# ==========================================
# Copy this file to '.env' locally or configure in Render Dashboard.
# Real credentials live securely in the database and are never committed to GitHub.

# SUPABASE POSTGRESQL (From Supabase Dashboard -> Settings -> Database)
SPRING_DATASOURCE_URL=jdbc:postgresql://db.YOUR_PROJECT_REF.supabase.co:5432/postgres?prepareThreshold=0&preparedStatementCacheQueries=0&preferQueryMode=simple
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_secure_supabase_password

# GMAIL SMTP (Use an App Password, NOT your personal Gmail password)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your_clinic_email@example.com
SPRING_MAIL_PASSWORD=your_16_digit_app_password

# BREVO EMAIL API (Primary high-deliverability 6-digit OTP delivery on Port 443)
# Get your free API key at https://app.brevo.com/settings/keys/api
BREVO_API_KEY=your_brevo_v3_api_key_here
BREVO_SENDER_EMAIL=your_clinic_email@example.com

# JWT SECURITY (Generate a random 64-character hex string)
JWT_SECRET=your_secure_random_cryptographic_key_here
JWT_EXPIRATION_MS=86400000

# SUPABASE AUTH TOKEN VERIFICATION (From Supabase Dashboard -> Settings -> API / Data API)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_or_publishable_key_here
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# Frontend Origin & CORS (Comma-separated exact origins)
FRONTEND_URL=https://derma-aline.vercel.app
CORS_ALLOWED_ORIGINS=https://derma-aline.vercel.app

# Appointment Scheduling Rules
APPOINTMENTS_MAX_PER_SLOT=1
APPOINTMENTS_OPEN_HOUR=10
APPOINTMENTS_CLOSE_HOUR=20

# CLINIC TIMEZONE
CLINIC_TIMEZONE=Asia/Kolkata

# OPTIONAL ACCOUNT OVERRIDES (Leave blank to keep existing DB credentials active)
ADMIN_EMAIL=
ADMIN_PASSWORD=
STAFF_EMAIL=
STAFF_PASSWORD=
