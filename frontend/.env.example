# ==========================================
# FRONTEND ENVIRONMENT VARIABLES (PUBLIC SAFE CONFIG ONLY)
# ==========================================
# Configure these in Vercel Dashboard -> Settings -> Environment Variables.
# Note: All VITE_* values are bundled into client-side browser JS; NEVER add private secrets here.

# Backend API base URL (Render)
VITE_API_BASE_URL=https://derma-aline.onrender.com/api

# Public Supabase client configuration for Google SSO
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
